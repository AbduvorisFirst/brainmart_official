[Unit]
Description=BrainMart Gunicorn Application Server
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/brainmart
EnvironmentFile=/var/www/brainmart/.env
ExecStart=/var/www/brainmart/venv/bin/gunicorn \
    --workers 3 \
    --threads 2 \
    --bind unix:/run/brainmart.sock \
    --access-logfile /var/log/gunicorn/brainmart_access.log \
    --error-logfile /var/log/gunicorn/brainmart_error.log \
    src.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
