# =======================================================
# BrainMart Production Environment Variables
# =======================================================

# Django Security
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-here-50-characters
DJANGO_ALLOWED_HOSTS=brainmart.uz,www.brainmart.uz,YOUR_SERVER_IP
SITE_URL=https://brainmart.uz

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=brainmart
DB_USER=brainmart_user
DB_PASSWORD=YourStrongDatabasePassword123!
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=BrainMart_bot
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_string

# AI (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key

# Instagram (Meta Graph API)
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token
META_WEBHOOK_VERIFY_TOKEN=your_verify_token
META_APP_SECRET=your_meta_app_secret

# Yandex Maps
YANDEX_MAPS_API_KEY=your_yandex_maps_key

# Billing Card for Subscriptions (Munisa Yakubova)
BRAINMART_BILLING_CARD=6262 4700 9041 1583
BRAINMART_BILLING_HOLDER=Munisa Yakubova

# CSRF Trusted Origins (Optional comma-separated list of extra origins)
DJANGO_CSRF_TRUSTED_ORIGINS=https://brainmart.uz,https://www.brainmart.uz
